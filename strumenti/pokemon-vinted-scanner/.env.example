# ============================================================
# Pokémon Vinted Deal Scanner — configurazione ambiente
# Copia questo file in ".env" e compila i valori.
# ============================================================

# --- Modalità operativa ---
# demo  = usa dati simulati, nessuna richiesta di rete reale
# manual_feed = legge annunci da un file che tu stesso popoli (vedi README)
# vinted_api  = placeholder per una fonte dati autorizzata futura (non implementato)
APP_MODE=demo

# --- Parametri di scansione ---
SCAN_INTERVAL=10
MIN_DISCOUNT=70
MIN_MARKET_VALUE=20
MAX_LISTING_PRICE=500
MIN_DEAL_SCORE=75

# --- Mercato Vinted (usati solo dai connettori reali/manuali) ---
VINTED_COUNTRY=IT
VINTED_LANGUAGE=it
VINTED_CATEGORY=pokemon

# --- Notifiche Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifiche Email (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Notifiche desktop/suono ---
DESKTOP_NOTIFICATION=true
SOUND_NOTIFICATION=true

# --- Database ---
DATABASE_PATH=./database/scanner.db

# --- Manual feed connector (usato solo se APP_MODE=manual_feed) ---
MANUAL_FEED_PATH=./demo_data/manual_feed.json
